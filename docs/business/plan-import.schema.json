{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "408doing 外部计划合同 v1—v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "title",
    "startDate",
    "endDate",
    "goals",
    "months",
    "weeks",
    "tasks",
    "days"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "endDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "subject",
          "title",
          "startDate",
          "endDate"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 0,
            "maxLength": 1000
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      },
      "maxItems": 2000,
      "minItems": 0
    },
    "months": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "month",
          "title"
        ],
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 0,
            "maxLength": 1000
          }
        }
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "weeks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "startDate",
          "title"
        ],
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 0,
            "maxLength": 1000
          }
        }
      },
      "maxItems": 2000,
      "minItems": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "subject",
          "unit",
          "title",
          "plannedAmount"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "goalKey": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 0,
            "maxLength": 64
          },
          "plannedAmount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0.01,
            "maximum": 99999999.99,
            "multipleOf": 0.01
          },
          "sequence": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "mode",
              "items"
            ],
            "properties": {
              "mode": {
                "const": "COMPLETE_THEN_ADVANCE"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key",
                    "title",
                    "url"
                  ],
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,64}$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000,
                      "format": "uri",
                      "pattern": "^https://"
                    }
                  }
                }
              }
            }
          },
          "activity": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "mode",
              "flexibleMinutes"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "TIMED_STUDY",
                  "RECAP",
                  "CHECK_ONLY",
                  "CONTINUED_STUDY"
                ]
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1000
              },
              "flexibleMinutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440
              }
            }
          },
          "continuation": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "streamKey",
              "title",
              "position"
            ],
            "properties": {
              "streamKey": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "position": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "activity"
              ],
              "properties": {
                "activity": {
                  "type": "object",
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "const": "CHECK_ONLY"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "plannedAmount": {
                  "type": "null"
                },
                "sequence": {
                  "type": "null"
                },
                "activity": {
                  "properties": {
                    "flexibleMinutes": {
                      "const": 0
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "activity"
              ],
              "properties": {
                "activity": {
                  "type": "object",
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "const": "CONTINUED_STUDY"
                    }
                  }
                }
              }
            },
            "then": {
              "required": [
                "continuation"
              ],
              "properties": {
                "continuation": {
                  "type": "object"
                },
                "plannedAmount": {
                  "type": "null"
                },
                "sequence": {
                  "type": "null"
                },
                "activity": {
                  "properties": {
                    "flexibleMinutes": {
                      "const": 0
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "continuation"
              ],
              "properties": {
                "continuation": {
                  "type": "object"
                }
              }
            },
            "then": {
              "required": [
                "activity"
              ],
              "properties": {
                "activity": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "const": "CONTINUED_STUDY"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "maxItems": 20000,
      "minItems": 1
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "items"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "taskKey",
                "amount"
              ],
              "properties": {
                "taskKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "amount": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0.01,
                  "maximum": 99999999.99,
                  "multipleOf": 0.01
                },
                "estimatedMinutes": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 2147483647
                }
              }
            },
            "maxItems": 2000,
            "minItems": 0
          }
        }
      },
      "maxItems": 5000,
      "minItems": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "tasks": {
            "items": {
              "properties": {
                "sequence": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              1,
              2
            ]
          }
        }
      },
      "then": {
        "properties": {
          "tasks": {
            "items": {
              "properties": {
                "plannedAmount": {
                  "type": "number"
                },
                "activity": {
                  "type": "null"
                }
              }
            }
          },
          "days": {
            "items": {
              "properties": {
                "items": {
                  "items": {
                    "properties": {
                      "amount": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              1,
              2,
              3
            ]
          }
        }
      },
      "then": {
        "properties": {
          "tasks": {
            "items": {
              "properties": {
                "activity": {
                  "properties": {
                    "mode": {
                      "enum": [
                        "TIMED_STUDY",
                        "RECAP"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              1,
              2,
              3,
              4
            ]
          }
        }
      },
      "then": {
        "properties": {
          "tasks": {
            "items": {
              "properties": {
                "continuation": {
                  "type": "null"
                },
                "activity": {
                  "properties": {
                    "mode": {
                      "enum": [
                        "TIMED_STUDY",
                        "RECAP",
                        "CHECK_ONLY"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
