{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "408doing 外部计划合同 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "title",
    "startDate",
    "endDate",
    "goals",
    "months",
    "weeks",
    "tasks",
    "days"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "endDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "subject",
          "title",
          "startDate",
          "endDate"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 0,
            "maxLength": 1000
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      },
      "maxItems": 2000,
      "minItems": 0
    },
    "months": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "month",
          "title"
        ],
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 0,
            "maxLength": 1000
          }
        }
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "weeks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "startDate",
          "title"
        ],
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 0,
            "maxLength": 1000
          }
        }
      },
      "maxItems": 2000,
      "minItems": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "subject",
          "unit",
          "title",
          "plannedAmount"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "goalKey": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 0,
            "maxLength": 64
          },
          "plannedAmount": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 99999999.99,
            "multipleOf": 0.01
          }
        }
      },
      "maxItems": 20000,
      "minItems": 1
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "items"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "taskKey",
                "amount"
              ],
              "properties": {
                "taskKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "amount": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 99999999.99,
                  "multipleOf": 0.01
                },
                "estimatedMinutes": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 2147483647
                }
              }
            },
            "maxItems": 2000,
            "minItems": 0
          }
        }
      },
      "maxItems": 5000,
      "minItems": 1
    }
  }
}
