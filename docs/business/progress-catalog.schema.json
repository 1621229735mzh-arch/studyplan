{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "学习进度完整目录 v1/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "courses"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "courses": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/course" } }
  },
  "allOf": [{ "if": { "properties": { "schemaVersion": { "const": 1 } } }, "then": { "properties": { "courses": { "items": { "properties": { "progressMode": { "enum": ["QUANTITY"] } } } } } } }],
  "$defs": {
    "key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "course": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "direction", "branch", "title", "subjectId", "unitId", "nodes"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "progressMode": { "enum": ["QUANTITY", "CONTENT_PERCENT"] },
        "direction": { "enum": ["MATH", "ENGLISH", "POLITICS", "CS408"] },
        "branch": { "type": "string", "minLength": 1, "maxLength": 100 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subjectId": { "type": "integer", "minimum": 1 },
        "unitId": { "type": "integer", "minimum": 1 },
        "nodes": { "type": "array", "minItems": 1, "maxItems": 2000, "items": { "$ref": "#/$defs/node" } }
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "title", "taskIds"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "parentKey": { "anyOf": [{ "$ref": "#/$defs/key" }, { "type": "null" }] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "totalAmount": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 999999999999.999999, "multipleOf": 0.000001 },
        "sortOrder": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "taskIds": { "type": "array", "maxItems": 2000, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } }
      }
    }
  }
}
