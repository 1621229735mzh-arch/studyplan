# 复制为 .env 后填写真实值；此文件只包含变量名与无敏感信息的示例值。
# .env 已被 .gitignore 忽略，禁止提交真实口令。

# ---- 镜像与版本 ----
# 固定版本标签，不使用 latest 之外的浮动值
IMAGE_TAG=0.1.0
BACKEND_IMAGE=ghcr.io/OWNER/REPO/backend
FRONTEND_IMAGE=ghcr.io/OWNER/REPO/frontend
HTTP_PORT=80

# ---- 数据库 ----
DB_NAME=kaoyan_study
DB_USERNAME=kaoyan
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# ---- 预设账号 ----
# 仅首次启动创建账号时使用；登录口令以 BCrypt 哈希保存在数据库中
PRESET_ACCOUNT_USERNAME=kaoyan
PRESET_ACCOUNT_PASSWORD=change-me-on-first-run

# ---- 会话 ----
SESSION_TIMEOUT=7d
